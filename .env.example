# ==============================================================================
# Environment Configuration for Media Metadata Extractor
# ==============================================================================

# Application profile: 'local' (development defaults) or 'production' (strict security checks)
APP_PROFILE=local

# MongoDB Connection Configuration
# In production, replace with real credentials or inject via secret manager.
MONGODB_URI=mongodb://media_app:your_secure_password@localhost:27017/media_index_db?authSource=media_index_db
MONGODB_PASSWORD=your_secure_password
MONGODB_COLLECTION=media_assets

# Performance & Batch Settings
MEDIA_FAST_MODE=false
MEDIA_EXTRACTION_MODE=balanced
MEDIA_MAX_HASH_SIZE_MB=100
SCAN_BATCH_SIZE=500
BACKPRESSURE_CAPACITY=100

# Optional explicit drive configuration file (defaults to drives.yaml if present)
# MEDIA_DRIVES_CONFIG=./drives.yaml

# ==============================================================================
# Media Drives Configuration (Multi-Drive Deduplication & Ingestion)
# ==============================================================================
# Define drive mount points directly here without needing a drives.yaml file:

# Primary Master Drive (Priority 100 - Single Source of Truth)
DRIVE_PRIMARY_MOUNT=/Volumes/SP-1
DRIVE_PRIMARY_MASTER=/Volumes/SP-1/SPSA/media/master

# Replica 1 Drive (Priority 80 - Backup Mirror)
DRIVE_REPLICA1_MOUNT=/Volumes/SP-2
DRIVE_REPLICA1_MASTER=/Volumes/SP-2/SPSA/media/master

# Replica 2 Drive (Priority 70 - Secondary Backup)
DRIVE_REPLICA2_MOUNT=/Volumes/SP-3
DRIVE_REPLICA2_MASTER=/Volumes/SP-3/SPSA/media/master
